# Configuration d'Environnement - Exemple
# Copier ce fichier en .env et configurer les valeurs

# ===== BASE DE DONNÉES =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=samajob

# ===== SERVER =====
NODE_ENV=development
PORT=3000

# ===== JWT =====
JWT_SECRET=votre_clé_secrète_très_sécurisée_min_32_caractères
JWT_EXPIRE=7d

# ===== CORS =====
FRONTEND_URL=http://localhost:3000

# ===== FICHIERS =====
MAX_FILE_SIZE=5242880

# ===== EMAIL (Optionnel, pour Nodemailer) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_app
SMTP_FROM=noreply@samajob.com

# ===== Firebase (Mobile) =====
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# ===== API Mobile =====
REACT_APP_API_URL=http://192.168.x.x:3000/api
