# Configuration Mobile - Exemple
# Copier ce fichier en .env.local et configurer les valeurs

# ===== API =====
REACT_APP_API_URL=http://192.168.1.100:3000/api

# ===== Firebase Configuration =====
REACT_APP_FIREBASE_API_KEY=AIzaSyDemoKey...
REACT_APP_FIREBASE_AUTH_DOMAIN=samajob-demo.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=samajob-demo
REACT_APP_FIREBASE_STORAGE_BUCKET=samajob-demo.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:ios:abcd1234...

# ===== Environnement =====
NODE_ENV=development
